  "main": "index.js",
  "scripts": {
    "clean": "rimraf public",
    "start": "ELEVENTY_ENV=dev eleventy --serve & tailwindcss -i ./src/css/style.css -o ./public/css/style.css --watch",
    "build": "npm run clean && ELEVENTY_ENV=prod eleventy && tailwindcss -i ./src/css/style.css -o ./public/css/style.css --minify",
    "format": "prettier --write \"src/**/*.{js,njk,md,css,json}\" \"*.{js,json}\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^1.0.2",
    "@11ty/eleventy-plugin-syntaxhighlight": "^4.2.0",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.0",
    "tailwindcss": "^3.2.4",
    "luxon": "^3.0.1"
  }
}
