<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{% if description %}{{ description }}{% else %}Tommy Bernaciak - Front-end Developer. Articles on React, TypeScript, JavaScript, CSS and more.{% endif %}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;1,300&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
	<!-- Google tag (gtag.js) -->
	{% if env.isProd %}
		<script async src="https://www.googletagmanager.com/gtag/js?id={{ env.gId }}"></script>
		<script>
  			window.dataLayer = window.dataLayer || [];
  			function gtag(){dataLayer.push(arguments);}
  			gtag('js', new Date());
			gtag('config', '{{ env.gId }}');
		</script>
	{% endif %}
    <title>{{ title }}</title>
</head>
<body>
    <div class="relative min-h-screen flex flex-col">
		<nav class="fixed w-full z-20 top-0 left-0 bg-[#fffdfb]/90 backdrop-blur-sm border-b border-[#ece8e3]">
			<div class="w-full max-w-3xl mx-auto px-6 py-5 flex items-center justify-between">
				<a href="/" class="whitespace-nowrap" style="font-family: 'Playfair Display', serif; font-size: 1.35rem; font-weight: 600; letter-spacing: 0.02em; color: #2b2b2b;">
					Tommy Bernaciak
				</a>
				<a href="/about" class="eyebrow whitespace-nowrap hover:opacity-70">
					About
				</a>
			</div>
		</nav>
		<main class="grow pt-28 pb-16 md:pt-36 md:pb-24">
			<div class="w-full max-w-2xl mx-auto px-6">
				{{ content | safe }}
			</div>
		</main>
		<footer class="fixed bottom-0 left-0 w-full z-20 py-2 bg-[#fffdfb]/90 backdrop-blur-sm border-t border-[#ece8e3]">
			<div class="max-w-2xl mx-auto px-6 text-center eyebrow">© {{ env.currentYear }} Tommy Bernaciak &middot; All rights reserved</div>
		</footer>
	</div>
</body>
</html>